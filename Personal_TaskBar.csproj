<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Personal_TaskBar</AssemblyName>
    <RootNamespace>Personal_TaskBar</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- Publish profile: dotnet publish produces a single self-contained exe -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- TOML parsing library – the only external dependency allowed by spec -->
    <PackageReference Include="Tomlyn" Version="0.16.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed the docs folder so QUICKSTART.md ships next to the exe -->
    <None Update="Docs\QUICKSTART.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Docs\MANUAL.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Docs\CHANGELOG.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
